# Cloudflare Pages response headers.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # --- Zero-risk hardening (safe to enforce immediately) ---
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  # HSTS: 1 year, no `preload` yet. Add `; preload` only once you're certain the
  # apex + every subdomain (cms., blog.) will ALWAYS be HTTPS — preload is hard to undo.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # --- CSP in REPORT-ONLY: logs violations, blocks nothing. ---
  # Watch the browser console on the *.pages.dev preview across every route + the
  # 3D pages + the Calendly widget + the quiz (NREL/weather calls). When the report
  # is clean, rename the header to `Content-Security-Policy` to enforce it.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.cdnfonts.com https://assets.calendly.com; font-src 'self' data: https://fonts.gstatic.com https://fonts.cdnfonts.com; img-src 'self' data: blob: https://images.unsplash.com https://images.squarespace-cdn.com https://*.calendly.com; connect-src 'self' https://developer.nrel.gov https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.weather.gov https://get.geojs.io https://*.calendly.com; worker-src 'self' blob:; child-src blob:; frame-src https://calendly.com https://*.calendly.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Long-cache the fingerprinted build assets (Vite hashes filenames, so this is safe).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Long-cache the heavy 3D models & textures.
/models/*
  Cache-Control: public, max-age=31536000, immutable
