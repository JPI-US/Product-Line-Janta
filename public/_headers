# Cloudflare Pages response headers.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # --- Zero-risk hardening (safe to enforce immediately) ---
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  # HSTS: 1 year, no `preload` yet. Add `; preload` only once you're certain the
  # apex + every subdomain (cms., blog.) will ALWAYS be HTTPS — preload is hard to undo.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # --- CSP in REPORT-ONLY: logs violations, blocks nothing. ---
  # Watch the browser console on the *.pages.dev preview across every route + the
  # 3D pages + the Calendly widget + the quiz (NREL/weather calls). When the report
  # is clean, rename the header to `Content-Security-Policy` to enforce it.
  # NOTE: Cloudflare auto-injects its Web Analytics beacon (static.cloudflareinsights.com)
  # on the custom domain but NOT on *.pages.dev — which is why that violation only
  # appears on jantaus.com. Allowed in script-src/connect-src so the policy stays
  # clean and doesn't break the beacon if/when this is switched to enforcing.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://assets.calendly.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.cdnfonts.com https://assets.calendly.com; font-src 'self' data: https://fonts.gstatic.com https://fonts.cdnfonts.com; img-src 'self' data: blob: https://images.unsplash.com https://images.squarespace-cdn.com https://*.calendly.com; connect-src 'self' https://developer.nrel.gov https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.weather.gov https://get.geojs.io https://*.calendly.com https://cloudflareinsights.com https://challenges.cloudflare.com; worker-src 'self' blob:; child-src blob:; frame-src https://calendly.com https://*.calendly.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# --- The HTML entry must NEVER be cached. ---
# index.html is the only file that maps to the current build's hashed chunk names.
# If a CDN/browser serves a stale index.html, it requests chunks from an old build
# that no longer exist; the SPA fallback (/* -> /index.html 200) then answers those
# .js requests with HTML, and the browser fails with:
#   "Loading module ... blocked because of a disallowed MIME type (text/html)"
# That's the recurring "stale deploy" white-screen. no-cache forces revalidation,
# so a new deploy is picked up immediately. The hashed assets below stay immutable,
# so this costs one cheap 304 per load, not re-downloading the bundle.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Long-cache the fingerprinted build assets (Vite hashes filenames, so this is safe).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Long-cache the heavy 3D models & textures.
/models/*
  Cache-Control: public, max-age=31536000, immutable
