# Vite build-time environment variables.
# Copy to `.env` (or `.env.local`) and fill in real values before building.
# All VITE_-prefixed vars are inlined at build time and exposed to the client.

# Calendly scheduling link used on the quiz "See Your Savings" summary step.
# Falls back to a built-in default event URL when unset.
VITE_CALENDLY_URL=

# NREL PVWatts API for the savings estimate (quiz).
# VITE_NREL_API_BASE: optional custom API origin; defaults to NREL's public host.
# VITE_NREL_API_KEY: NREL developer key; falls back to "DEMO_KEY" (rate-limited) when unset.
VITE_NREL_API_BASE=
VITE_NREL_API_KEY=

# Cloudflare Turnstile PUBLIC site key for the contact form's bot check.
# This is safe to expose in the client bundle. It is a BUILD-TIME var, so set it
# in Cloudflare Pages (Settings → Environment variables) BEFORE the build runs.
# Left blank locally, `vite dev` falls back to Cloudflare's always-pass test key.
VITE_TURNSTILE_SITE_KEY=
