{
  "name": "janta-product-line",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/compress-models.mjs && node scripts/compress-images.mjs",
    "build": "tsc -b && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "compress:models": "node scripts/compress-models.mjs",
    "compress:images": "node scripts/compress-images.mjs",
    "analyze": "ANALYZE=1 vite build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:visual": "vite build && playwright test",
    "optimize:models": "node scripts/optimize-models.mjs",
    "bake:utility": "npx tsx scripts/bake-utility-ready.ts",
    "bake:utility-prerender": "node scripts/bake-utility-prerender-browser.mjs",
    "bake:utility-prerender:headless": "npx tsx scripts/bake-utility-prerender.ts",
    "build:roots-video": "powershell -ExecutionPolicy Bypass -File scripts/build-roots-highlight.ps1"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "framer-motion": "^11.11.17",
    "gsap": "^3.15.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@playwright/test": "^1.61.1",
    "@types/gl": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.3",
    "draco3dgltf": "^1.5.7",
    "gl": "^8.0.2",
    "meshoptimizer": "^1.2.0",
    "playwright": "^1.61.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
}
